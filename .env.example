# Configuration reference only. Wrangler loads .dev.vars locally, not this file.
# Run node scripts/local-setup.mjs to generate local access keys.
# In production, use the hosting provider's secret manager for credentials.
AUTH_MODE=links
OWNER_ACCESS_KEY=
PARTNER_ACCESS_KEY=

# AI stays disabled unless a server key AND AI_ENABLED=true are configured.
OPENAI_API_KEY=
AI_ENABLED=false
AI_MONTHLY_LIMIT=1000
# Optional model override: confirm availability in your OpenAI project first.
# OPENAI_MODEL=your-supported-model
